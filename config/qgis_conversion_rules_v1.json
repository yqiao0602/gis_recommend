{
  "schema": "gis_recommend.qgis_conversion_rule_registry.v1",
  "version": "qgis-conversion-rules-v1",
  "auto_accept_gate": {
    "minimum_observed_precision": 0.95,
    "minimum_reviewed_support": 30,
    "minimum_wilson_lower_bound": 0.80
  },
  "prohibited_fields": [
    "review_index",
    "record_id",
    "source_path",
    "relative_path",
    "repository",
    "repo_name"
  ],
  "default_action": "human_review",
  "validation_eligible": false,
  "test_eligible": false,
  "production_merge": "not_granted"
}
