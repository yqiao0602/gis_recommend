# ============================================================
# GIS Recommend System — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values.
# .env is git-ignored and will NOT be committed.
# ============================================================

# ── LLM API ──────────────────────────────────────────────
# DeepSeek API (primary, used for task_type classification)
DEEPSEEK_API_KEY=sk-your-key-here
# Fallback / legacy key name
LLM_API_KEY=sk-your-key-here

# ── Compute Server ───────────────────────────────────────
# GPU training / evaluation server
COMPUTE_HOST=10.191.2.38
COMPUTE_USER=qy
# Optional: SSH key path (defaults to ~/.ssh/id_rsa)
# COMPUTE_SSH_KEY=~/.ssh/id_rsa

# ── Neo4j Knowledge Graph ───────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=12345678

# ── Paths (server-side) ─────────────────────────────────
# Project root on the compute server
COMPUTE_PROJECT_ROOT=/home/qy/system_redesign
# Read-only upstream data
COMPUTE_YLL_DATA=/home/yll/GEE

# ── Model / Inference ───────────────────────────────────
# Default BERT model (must be cached locally on server)
BERT_MODEL=bert-base-uncased
# Set to 1 to prevent HuggingFace downloads (server without internet)
TRANSFORMERS_OFFLINE=1
